{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meris-eshop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_NAME": "Meris E-Shop"
  },
  "observability": {
    "enabled": true
  }
}
