# =============================================================================
# MERIS E-SHOP — Cloudflare Workers environment template
# Copy this file to .dev.vars for local development:
#     cp .dev.vars.example .dev.vars
# In production, set every value with:
#     npx wrangler secret put <NAME>
# NEVER commit .dev.vars or real secrets to git.
# =============================================================================

# ---------------------------------------------------------------------------
# Public app URL (used for email links, payment callbacks, CORS)
# Local dev: http://localhost:8787 — Production: your workers.dev or custom domain
# ---------------------------------------------------------------------------
APP_URL="http://localhost:8787"

# ---------------------------------------------------------------------------
# Security — JWT & Admin auth (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET="YOUR_STRONG_RANDOM_JWT_SECRET_MIN_64_CHARS"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="YOUR_STRONG_ADMIN_PASSWORD"

# ---------------------------------------------------------------------------
# Supabase admin database (REQUIRED — single source of truth for the whole site)
# https://supabase.com/dashboard → Project Settings → API → service_role key
# ---------------------------------------------------------------------------
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="product-images"

# ---------------------------------------------------------------------------
# Resend mail service (REQUIRED for OTP login + order emails)
# https://resend.com → API Keys. Sender domain must be verified in Resend.
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="Meris E-Shop <orders@your-verified-domain.com>"

# Admin inbox that receives every new-order alert.
ADMIN_NOTIFICATION_EMAIL="admin@your-verified-domain.com"

# ---------------------------------------------------------------------------
# Gemini AI (optional — smart search, recommendations, invoice greeting)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""

# ---------------------------------------------------------------------------
# Razorpay (optional — online payments)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# ST Courier delivery-rate proxy (optional)
# ---------------------------------------------------------------------------
ST_COURIER_PICKUP_PINCODE="629401"
