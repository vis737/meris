# =============================================================================
# MERIS E-SHOP — Environment Variables
# Copy this file to .env and fill in real values for local development.
# On Railway/Render: set all of these in the service Environment Variables.
# NEVER commit .env to git.
# =============================================================================

# ---------------------------------------------------------------------------
# App URL (REQUIRED in production)
# ---------------------------------------------------------------------------
# Set this to your actual Railway/Render URL after deploying.
# Example: https://your-app.up.railway.app
# Used for: CORS, email links, OTP emails, order tracking links.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Security — JWT & Admin Auth (REQUIRED)
# ---------------------------------------------------------------------------
# Generate a strong random secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Render can auto-generate this: set generateValue: true in render.yaml
JWT_SECRET="YOUR_STRONG_RANDOM_JWT_SECRET_MIN_64_CHARS"

# Admin portal credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="YOUR_STRONG_ADMIN_PASSWORD"

# ---------------------------------------------------------------------------
# Supabase Database (REQUIRED for production)
# ---------------------------------------------------------------------------
# Get from: https://supabase.com/dashboard → Project Settings → API
# Use the SERVICE ROLE key (not anon key) — keep it secret!
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Product image uploads use Supabase Storage in production.
# The app will create this public bucket automatically when using the service role key.
SUPABASE_STORAGE_BUCKET="product-images"

# Optional only if you attach a persistent Railway volume and want local JSON/uploads fallback.
# Example Railway volume mount: /data
DATA_DIR=""

# ---------------------------------------------------------------------------
# Email / SMTP (REQUIRED for OTP login and order notifications)
# ---------------------------------------------------------------------------
# Gmail setup:
#   1. Enable 2-Factor Authentication on your Google account
#   2. Go to: myaccount.google.com/apppasswords
#   3. Create an App Password → copy the 16-char password (remove spaces)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"   # 16-char Gmail App Password
SMTP_FROM_NAME="Meris E-Shop"
SMTP_FROM_EMAIL="orders@orders.meriseshop.com"
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="orders@orders.meriseshop.com"

# Mailbox that receives every new-order admin alert.
# Dedicated admin inbox — do not set this to a sender/relay account.
ADMIN_NOTIFICATION_EMAIL="meriseshop.2025@gmail.com"

# Set to "true" to send real emails. When "false", OTP is returned in the API
# response body (dev mode only — never expose OTP in production responses).
ENABLE_REAL_NOTIFICATIONS="true"

# ---------------------------------------------------------------------------
# Gemini AI (Optional — for smart search & product recommendations)
# ---------------------------------------------------------------------------
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ---------------------------------------------------------------------------
# PayU Payment Gateway (Required for online payments)
# ---------------------------------------------------------------------------
# Get these from your PayU merchant dashboard.
PAYU_MERCHANT_KEY="YOUR_PAYU_MERCHANT_KEY"
PAYU_MERCHANT_SALT="YOUR_PAYU_MERCHANT_SALT"
PAYU_ENV="test" # "test" or "production"

# Optional override URLs. Defaults are derived from APP_URL.
PAYU_SUCCESS_URL="http://localhost:3000/api/payu/success"
PAYU_FAILURE_URL="http://localhost:3000/api/payu/failure"
PAYU_WEBHOOK_URL="http://localhost:3000/api/payu/webhook"

# ---------------------------------------------------------------------------
# Twilio SMS (Optional — for order confirmation SMS)
# ---------------------------------------------------------------------------
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_NUMBER=""            # Your Twilio number in E.164: +15017122661
TWILIO_WHATSAPP_NUMBER=""       # WhatsApp sender: whatsapp:+14155238886
